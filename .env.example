BUTTONDOWN_API_KEY=          # Buttondown → Settings → API, for the email sign-ups (without it they finish in a popup)
UPSTASH_REDIS_REST_URL=      # set by the Vercel Marketplace integration (or KV_REST_API_URL)
UPSTASH_REDIS_REST_TOKEN=    # set by the Vercel Marketplace integration (or KV_REST_API_TOKEN)
GITHUB_TOKEN=                # read-only token so build-time star lookups aren't rate-limited
