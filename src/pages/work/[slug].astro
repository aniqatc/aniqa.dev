---
import { render } from 'astro:content';
import '../../styles/pictures.css';
import '../../styles/mac-screen.css';
import Detail from '../../layouts/Detail.astro';
import Facts from '../../components/Facts.astro';
import GetItButton from '../../components/GetItButton.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import LaunchEnd from '../../components/LaunchEnd.astro';
import LaunchHero from '../../components/LaunchHero.astro';
import PrevNext from '../../components/PrevNext.astro';
import SiteScreenshot from '../../components/SiteScreenshot.astro';
import Stars from '../../components/Stars.astro';
import { factsFor, getItHref } from '../../lib/launch';
import { getSelected, pad, type Project } from '../../lib/projects';

// One case study per selected project; previous / next wrap around.
export async function getStaticPaths() {
  const selected = await getSelected();
  const total = selected.length;
  return selected.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      i,
      total,
      prev: selected[(i - 1 + total) % total],
      next: selected[(i + 1) % total],
    },
  }));
}

interface Props {
  project: Project;
  i: number;
  total: number;
  prev: Project;
  next: Project;
}

const { project, i, total, prev, next } = Astro.props;
const { title, summary, pageTitle, price, launch } = project.data;
const { Content } = await render(project);
// the facts under the lede, and where Get it goes when it's for sale (src/lib/launch.ts)
const facts = factsFor(project);
const getHref = getItHref(project);
---

<Detail
  entry={project}
  mode="portfolio"
  variant="cs"
  title={title}
  pageTitle={pageTitle}
  lede={summary}
  back={{ href: '/', label: '← Home' }}
  position={`${pad(i + 1)} / ${pad(total)}`}
>
  <Stars slot="actions" repo={project.data.repo} title={title} variant="button" />
  <Fragment slot="eyebrow">
    Selected work <b>{pad(i + 1)}</b>
  </Fragment>
  <Fragment slot="facts">
    {getHref && (
      <p class="get-it">
        <GetItButton href={getHref} label={`Get it · ${price}`} />
      </p>
    )}
    <Facts class="entry-facts" items={facts} />
  </Fragment>
  {/* ---------- a launch: the app on a Mac screen and a gallery; otherwise the website's screenshot ---------- */}
  {launch ? <LaunchHero project={project} /> : <SiteScreenshot entry={project} />}
  <Content />
  {launch && <LaunchEnd project={project} />}
  <ImageLightbox />
  {total > 1 && (
    <PrevNext
      label="More work"
      labels={['← Previous', 'Next →']}
      prev={{ href: `/work/${prev.id}`, title: prev.data.title }}
      next={{ href: `/work/${next.id}`, title: next.data.title }}
    />
  )}
</Detail>

<style>
  /* the Get it button under the lede, above the facts */
  .get-it {
    margin: 4px 0 0;
  }
</style>
