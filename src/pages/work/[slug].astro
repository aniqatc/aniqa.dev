---
import { render } from 'astro:content';
import '../../styles/pictures.css';
import Detail from '../../layouts/Detail.astro';
import Facts from '../../components/Facts.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import PrevNext from '../../components/PrevNext.astro';
import SiteScreenshot from '../../components/SiteScreenshot.astro';
import Stars from '../../components/Stars.astro';
import { fmtMonth, getSelected, links, pad, type Project } from '../../lib/projects';

// One case study per selected project; previous / next wrap around.
export async function getStaticPaths() {
  const selected = await getSelected();
  const total = selected.length;
  return selected.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      i,
      total,
      prev: selected[(i - 1 + total) % total],
      next: selected[(i + 1) % total],
    },
  }));
}

interface Props {
  project: Project;
  i: number;
  total: number;
  prev: Project;
  next: Project;
}

const { project, i, total, prev, next } = Astro.props;
const { title, type, stack, released, summary, pageTitle, price, priceNote, requires, getUrl, extraLinks, featuredOn } =
  project.data;
const { Content } = await render(project);

// ---------- Facts under the lede: price and requirements first for a product, then the usual four ----------
const facts = [
  ...(price ? [{ label: 'Price', value: price, note: priceNote }] : []),
  ...(requires ? [{ label: 'Requires', value: requires }] : []),
  { label: 'Released', value: fmtMonth(released) },
  { label: 'Type', value: type },
  { label: 'Stack', value: stack },
  { label: 'Links', value: [...links(project), ...extraLinks.map((l) => ({ ...l, label: `${l.label} ↗` }))] },
  ...(featuredOn.length ? [{ label: 'Featured on', value: featuredOn.map((l) => ({ ...l, label: `${l.label} ↗` })) }] : []),
];

// ---------- "Get it" button: only for something people buy; goes to getUrl, or the live site ----------
const getHref = price ? (getUrl ?? (project.data.live ? `https://${project.data.live}` : undefined)) : undefined;
---

<Detail
  entry={project}
  mode="portfolio"
  variant="cs"
  title={title}
  pageTitle={pageTitle}
  lede={summary}
  back={{ href: '/', label: '← Home' }}
  position={`${pad(i + 1)} / ${pad(total)}`}
>
  <Stars slot="actions" repo={project.data.repo} title={title} variant="button" />
  <Fragment slot="eyebrow">
    Selected work <b>{pad(i + 1)}</b>
  </Fragment>
  <Fragment slot="facts">
    {getHref && (
      <p class="get-it">
        <a class="get-it-button" href={getHref} target="_blank" rel="noopener">
          Get it · {price} <span aria-hidden="true">↗</span>
        </a>
      </p>
    )}
    <Facts class="entry-facts" items={facts} />
  </Fragment>
  <SiteScreenshot entry={project} />
  <Content />
  <ImageLightbox />
  {total > 1 && (
    <PrevNext
      label="More work"
      labels={['← Previous', 'Next →']}
      prev={{ href: `/work/${prev.id}`, title: prev.data.title }}
      next={{ href: `/work/${next.id}`, title: next.data.title }}
    />
  )}
</Detail>

<style>
  /* ---------- "Get it" button under the lede: the same pill as a review's Try it button ---------- */
  .get-it {
    margin: 4px 0 0;
  }
  .get-it-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font: 500 10.5px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background-color 0.2s;
  }
  .get-it-button:hover {
    background: var(--accent);
  }
  .get-it-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
