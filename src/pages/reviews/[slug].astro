---
import { render } from 'astro:content';
import '../../styles/reviews.css';
import Detail from '../../layouts/Detail.astro';
import DeviceScreens from '../../components/DeviceScreens.astro';
import Facts from '../../components/Facts.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import UpdatesSignup from '../../components/UpdatesSignup.astro';
import PrevNext from '../../components/PrevNext.astro';
import SiteScreenshot from '../../components/SiteScreenshot.astro';
import { pad } from '../../lib/projects';
import {
  appLinkLabel,
  appUrlFor,
  fmtDay,
  getReviews,
  makerUrl,
  reviewJsonLd,
  scoresFor,
  type Review,
} from '../../lib/reviews';
import { screenshotFor } from '../../lib/screenshots';

// One page per review; older / newer go along the series.
export async function getStaticPaths() {
  const reviews = await getReviews();
  return reviews.map((review, index) => ({
    params: { slug: review.id },
    props: { review, total: reviews.length, older: reviews[index - 1], newer: reviews[index + 1] },
  }));
}

interface Props {
  review: Review;
  total: number;
  older?: Review;
  newer?: Review;
}

const { review, total, older, newer } = Astro.props;
const { app, maker, date, type, triedOn, price, version, platforms, device, post, summary, verdict } =
  review.data;
const { Content } = await render(review);
const appUrl = appUrlFor(review);
const scores = scoresFor(review);
// structured data for search results; < is escaped so nothing in the text can close the script tag
const jsonLd = JSON.stringify(reviewJsonLd(review, new URL(Astro.url.pathname, Astro.site))).replace(
  /</g,
  '\\u003c',
);
const facts = [
  { label: 'Date', value: fmtDay(date) },
  { label: 'Maker', value: [{ label: `@${maker}`, href: makerUrl(review) }] },
  { label: 'Type', value: type },
  { label: 'Tried on', value: triedOn },
  // price, version and platforms are optional: left out of the facts when they aren't set
  ...(version ? [{ label: 'Version', value: version }] : []),
  ...(platforms?.length ? [{ label: 'Platforms', value: platforms.join(', ') }] : []),
  ...(price ? [{ label: 'Price', value: price }] : []),
  {
    label: 'Links',
    value: [
      { label: appLinkLabel(review), href: appUrl },
      ...(post ? [{ label: 'Post ↗', href: post }] : []),
    ],
  },
  { label: 'Overall', value: verdict },
];
---

<Detail
  entry={review}
  mode="portfolio"
  variant="rv"
  title={app}
  pageTitle={`${app} review`}
  published={date}
  lede={summary}
  back={{ href: '/reviews', label: '← All reviews' }}
  position={`${pad(review.number)} / ${pad(total)}`}
>
  <Fragment slot="eyebrow">
    App review <b>{pad(review.number)}</b>
  </Fragment>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLd} />
  <Facts slot="facts" class="review-facts" items={facts} />
  {device === 'browser' ? (
    screenshotFor(review) && <SiteScreenshot entry={review} />
  ) : (
    <DeviceScreens review={review} device={device} />
  )}

  <section class="sec review-scores" data-sec="scores">
    <h2 class="label">Scores</h2>
    <div>
      <dl class="score-grid">
        {scores.map((score) => (
          <div>
            <dt class="label">{score.label}</dt>
            <dd>
              <span class={`score-status score-${score.status}`}>{score.statusLabel}</span>
              <span class="score-dots" role="img" aria-label={`${score.value} out of 5`}>
                {[1, 2, 3, 4, 5].map((position) => (
                  <i class:list={{ on: position <= score.value }} />
                ))}
              </span>
            </dd>
          </div>
        ))}
      </dl>
      {review.data.stillBuilding && (
        <p class="review-note">
          How the app feels today. It’s still being built, so “needs love” just means there’s room to grow.
        </p>
      )}
    </div>
  </section>

  <Content />
  <ImageLightbox />

  <aside class="try-it" aria-labelledby="try-it-h">
    <div class="try-it-text">
      <p class="label">Try it yourself</p>
      <h2 id="try-it-h">
        {app} is made by{' '}
        <a href={makerUrl(review)} target="_blank" rel="noopener">
          @{maker}
        </a>
        .
      </h2>
      <p>
        Give it a go, and if you like it, let them know. Early feedback means a lot when you’re building
        something new.
      </p>
    </div>
    <div class="try-it-actions">
      <a class="try-it-button" href={appUrl} target="_blank" rel="noopener">
        Try {app} ↗
      </a>
    </div>
  </aside>

  {/* the mailing list, joined under the Try it card like a ticket stub */}
  <section class="rv-signup" aria-label="Mailing list">
    <div class="rv-signup-side" aria-hidden="true">
      <span class="rv-pet" data-stub-pet></span>
    </div>
    <div class="rv-signup-main">
      <p class="label rv-signup-label">Mailing list</p>
      <p class="rv-signup-sub">I’ll send a short note when a new review goes up.</p>
      <div class="rv-signup-form">
        <UpdatesSignup variant="stub" placeholder="Your email, for new reviews" tag="reviews" />
      </div>
    </div>
  </section>

  {total > 1 && (
    <PrevNext
      label="More reviews"
      labels={['← Older', 'Newer →']}
      prev={older && { href: `/reviews/${older.id}`, title: older.data.app }}
      next={newer && { href: `/reviews/${newer.id}`, title: newer.data.app }}
    />
  )}
</Detail>

<script>
  // the stub shows the same pet as the cursor pet: currentPet() is worked out in the browser from today's date
  import { currentPet, petMarkup } from '../../lib/pets';
  import { onPage } from '../../scripts/page';
  onPage(() => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-stub-pet]')) {
      el.dataset.pet = currentPet();
      el.innerHTML = petMarkup(el.dataset.pet as ReturnType<typeof currentPet>);
      // pet.ts places the eyes from data-x / data-y as it animates; here they just sit still
      for (const e of el.querySelectorAll<SVGGElement>('.e'))
        e.setAttribute('transform', `translate(${e.dataset.x},${e.dataset.y ?? -1})`);
    }
  });
</script>
