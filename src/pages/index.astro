---
import '../styles/portfolio.css';
import Base from '../layouts/Base.astro';
import LatestReview from '../components/LatestReview.astro';
import NowBuilding from '../components/NowBuilding.astro';
import UpdatesSignup from '../components/UpdatesSignup.astro';
import { TINKERING } from '../lib/now';
import { getLab, real, fmtMonth } from '../lib/projects';

// The Lab row: the three newest lab entries, then a link to all of them
const LATEST_LAB_COUNT = 3;
const labEntries = real(await getLab());
const latestLab = [...labEntries].reverse().slice(0, LATEST_LAB_COUNT);

// The intro's Hooked on line (the newest review) is hidden for now, during the Little Doors launch.
// Set this back to true to bring it back. The footer's Reviews link stays either way.
const SHOW_LATEST_REVIEW = false;
---

{/* Home: just the intro, centred on the page. Selected work moved into the lab, and the Lab row shows its
    newest entries with a link to the rest. */}
<Base mode="portfolio">
  <main class="wrap pf">
    <section class="intro" aria-labelledby="pf-h">
      <h1 id="pf-h">
        Aniqa<span class="dot">.</span>
      </h1>
      <p class="lede">
        I started building to see how things work.<br class="lede-break" /> Now I build <em>delightful little things</em> for the web.
      </p>
      <p class="intro-role label">Software engineer in New York</p>
      <dl class="intro-list">
        <div class="intro-row">
          <dt class="label">Tinkering</dt>
          <dd>
            <ul class="chips">
              {TINKERING.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </dd>
        </div>
        <NowBuilding />
        {SHOW_LATEST_REVIEW && <LatestReview />}
        <div class="intro-row">
          <dt class="label">Lab</dt>
          <dd class="intro-lab">
            <ol class="lab-latest">
              {latestLab.map((entry) => (
                <li>
                  <a href={`/lab/${entry.id}`}>
                    <span class="lab-latest-title">{entry.data.title}</span>
                    <span class="lab-latest-type">{entry.data.type}</span>
                    <span class="lab-latest-date">{fmtMonth(entry.data.released)}</span>
                  </a>
                </li>
              ))}
            </ol>
            <a class="lab-all" href="/lab">
              All {labEntries.length} things I’ve made <span aria-hidden="true">→</span>
            </a>
          </dd>
        </div>
      </dl>
    </section>

    <section class="updates" aria-label="Updates">
      <dl class="intro-list updates-list">
        <div class="intro-row">
          <dt class="label">Updates</dt>
          <dd>
            <UpdatesSignup />
          </dd>
        </div>
      </dl>
    </section>
  </main>
</Base>
