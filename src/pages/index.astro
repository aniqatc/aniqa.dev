---
import '../styles/portfolio.css';
import Base from '../layouts/Base.astro';
import LatestReview from '../components/LatestReview.astro';
import NowBuilding from '../components/NowBuilding.astro';
import UpdatesSignup from '../components/UpdatesSignup.astro';
import { TINKERING } from '../lib/now';
import { getImage } from 'astro:assets';
import { getLab, real } from '../lib/projects';
import { screenshotFor } from '../lib/screenshots';

// The Lab row: a fanned stack of the three newest lab screenshots, tinted mint so they sit on the dark page
const FAN_SIZE = 3;
const newestWithScreenshots = real(await getLab())
  .reverse()
  .filter((entry) => screenshotFor(entry))
  .slice(0, FAN_SIZE);
const fanImages = await Promise.all(
  newestWithScreenshots.map((entry) => getImage({ src: screenshotFor(entry)!, width: 240, format: 'webp' })),
);

// The intro's Hooked on line (the newest review) is hidden for now, during the Little Doors launch.
// Set this back to true to bring it back. The footer's Reviews link stays either way.
const SHOW_LATEST_REVIEW = false;
---

{/* Home: just the intro, centred on the page. Selected work moved into the lab, and the Lab row shows a
    fanned stack of its newest screenshots. */}
<Base mode="portfolio">
  <main class="wrap pf">
    <section class="intro" aria-labelledby="pf-h">
      <h1 id="pf-h">
        Aniqa<span class="dot">.</span>
      </h1>
      <p class="lede">
        I started building to see how things work.<br class="lede-break" /> Now I build <em>delightful little things</em> for the web.
      </p>
      <p class="intro-role label">Software engineer in New York</p>
      <dl class="intro-list">
        <div class="intro-row">
          <dt class="label">Tinkering</dt>
          <dd>
            <ul class="chips">
              {TINKERING.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </dd>
        </div>
        <NowBuilding />
        {SHOW_LATEST_REVIEW && <LatestReview />}
        <div class="intro-row lab-row">
          <dt class="label">Lab</dt>
          <dd>
            <a class="lab-fan-link" href="/lab">
              <span class="lab-fan" aria-hidden="true">
                {fanImages.map((image) => (
                  <img src={image.src} alt="" width="104" height="65" loading="lazy" decoding="async" />
                ))}
              </span>
              <span class="lab-fan-text">
                <span class="lab-fan-title">
                  See the lab <span aria-hidden="true">→</span>
                </span>
                <span class="lab-fan-blurb">My digital sketchbook: everything I’ve made while learning.</span>
              </span>
            </a>
          </dd>
        </div>
      </dl>
    </section>

    <section class="updates" aria-label="Updates">
      <dl class="intro-list updates-list">
        <div class="intro-row">
          <dt class="label">Updates</dt>
          <dd>
            <UpdatesSignup />
          </dd>
        </div>
      </dl>
    </section>
  </main>
</Base>
