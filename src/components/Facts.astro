---
// The label/value row: lab stats, detail page meta.
// A value is text, or a list of links (empty list shows a dash). An optional note sits under the value, quieter.
type Value = string | { label: string; href: string }[];

interface Props {
  items: { label: string; value: Value; note?: string }[];
  /** fixed column count; omit for 4, dropping to 2 on narrow screens */
  cols?: number;
  class?: string;
}

const { items, cols, class: className } = Astro.props;
---

<dl class:list={['facts', className]} style={cols ? `--cols:${cols}` : undefined}>
  {items.map(({ label, value, note }) => (
    <div>
      <dt class="label">{label}</dt>
      <dd>
        {typeof value === 'string'
          ? value
          : value.length
            ? value.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">
                  {l.label}
                </a>
              ))
            : '—'}
        {note && <span class="fact-note">{note}</span>}
      </dd>
    </div>
  ))}
</dl>
