---
// Portfolio intro: what's in progress. Edit BUILDING in src/lib/now.ts; the section hides itself when it's empty.
import NowTitle from './NowTitle.astro';
import { BUILDING } from '../lib/now';
---

{BUILDING.length > 0 && (
  <div class="intro-row">
    <dt class="label">Building</dt>
    <dd>
      <ul class="building">
        {BUILDING.map(({ title, blurb, href, status }) => (
          <li class:list={{ 'building-highlight': status }}>
            <div class="building-title-row">
              <i class="dot-on" aria-hidden="true" />
              <b>
                <NowTitle title={title} href={href} />
              </b>
              {status && <span class="building-status">{status}</span>}
            </div>
            <span class="building-blurb">{blurb}</span>
          </li>
        ))}
      </ul>
    </dd>
  </div>
)}

<style>
  .building {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  /* each item: the dot, title and pill on one line, then the blurb under it, flush with the dot so the
     Building items line up with the rest of the intro instead of sitting indented */
  li {
    display: flex;
    flex-direction: column;
  }
  .dot-on {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
    animation: building-pulse 2s ease-in-out infinite;
  }
  li b {
    display: block;
    font: 500 12px/1.4 var(--font-mono);
    color: var(--fg);
  }
  /* ---------- Title row: dot, title, then the status pill for a highlighted item ---------- */
  .building-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }
  .building-highlight .building-title-row :global(.now-link) {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  /* a small, quiet pill: the row's pulsing dot already marks the item, so the pill has no dot of its own */
  .building-status {
    display: inline-flex;
    align-items: center;
    height: 18px;
    padding: 0 7px;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font: 500 8.5px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
  .building-blurb {
    display: block;
    margin-top: 4px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted);
  }
  @keyframes building-pulse {
    50% {
      opacity: 0.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot-on {
      animation: none;
    }
  }
</style>
