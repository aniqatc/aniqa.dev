---
// Portfolio intro: a dotted list under a label. Used for Shipped and Building; edit both lists in
// src/lib/now.ts. The section hides itself when its list is empty.
import NowTitle from './NowTitle.astro';
import { BUILDING, type NowItem } from '../lib/now';

interface Props {
  label?: string; // the row's label on the left
  items?: NowItem[]; // the list to show; Building's by default
}
const { label = 'Building', items = BUILDING } = Astro.props;
---

{items.length > 0 && (
  <div class="intro-row">
    <dt class="label">{label}</dt>
    <dd>
      <ul class="building">
        {items.map(({ title, blurb, href, status, story }) => (
          <li class:list={{ 'building-highlight': status }}>
            <i class="dot-on" aria-hidden="true" />
            <div>
              <div class="building-title-row">
                <b>
                  <NowTitle title={title} href={href} />
                </b>
                {status && (
                  <span class="building-status">
                    <i aria-hidden="true" />
                    {status}
                  </span>
                )}
              </div>
              <span>{blurb}</span>
              {story && (
                <a class="building-story" href={story}>
                  Read about it <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </dd>
  </div>
)}

<style>
  .building {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  li {
    display: grid;
    grid-template-columns: 7px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  .dot-on {
    width: 7px;
    height: 7px;
    margin-top: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
    animation: building-pulse 2s ease-in-out infinite;
  }
  li b {
    display: block;
    font: 500 12px/1.4 var(--font-mono);
    color: var(--fg);
  }
  /* ---------- Highlighted item: accent title, then a status pill like the spotlight's "Out now" ---------- */
  /* the title and pill sit side by side, centred on each other; the pill drops under the title if there's no room */
  .building-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }
  .building-highlight .building-title-row :global(.now-link) {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .building-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 20px;
    padding: 0 9px 0 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    font: 500 9px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
  /* the same pulsing dot as the list, sized for the pill */
  .building-status i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    animation: building-pulse 2s ease-in-out infinite;
  }
  /* the blurb under each title (only the direct child, so spans inside its links keep their own styles) */
  li > div > span {
    display: block;
    margin-top: 2px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 44ch;
  }
  /* ---------- Write-up link: its own small mono line under the blurb, in the text colour ---------- */
  .building-story {
    display: inline-block;
    margin-top: 6px;
    font: 400 11px/1.4 var(--font-mono);
    color: var(--fg);
    white-space: nowrap;
    border-bottom: 1px solid var(--line);
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .building-story:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  @keyframes building-pulse {
    50% {
      opacity: 0.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .building-status i {
      animation: none;
    }
  }
</style>
