---
// Portfolio intro: what's in progress. Edit BUILDING in src/lib/now.ts; the section hides itself when it's empty.
import NowTitle from './NowTitle.astro';
import { BUILDING } from '../lib/now';
---

{BUILDING.length > 0 && (
  <div class="intro-row">
    <dt class="label">Building</dt>
    <dd>
      <ul class="building">
        {BUILDING.map(({ title, blurb, href, status }) => (
          <li class:list={{ 'building-highlight': status }}>
            <i class="dot-on" aria-hidden="true" />
            <div>
              <b class="building-title">
                <NowTitle title={title} href={href} />
                {status && <span class="building-status">{status}</span>}
              </b>
              <span>{blurb}</span>
            </div>
          </li>
        ))}
      </ul>
    </dd>
  </div>
)}

<style>
  .building {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  li {
    display: grid;
    grid-template-columns: 7px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  .dot-on {
    width: 7px;
    height: 7px;
    margin-top: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
    animation: building-pulse 2s ease-in-out infinite;
  }
  li b {
    display: block;
    font: 500 12px/1.4 var(--font-mono);
    color: var(--fg);
  }
  /* ---------- Highlighted item: accent title and a status pill, like the spotlight's "Out now" ---------- */
  .building-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }
  .building-highlight .building-title :global(.now-link) {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .building-status {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    font: 500 9px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  li span:not(.building-status) {
    display: block;
    margin-top: 2px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 44ch;
  }
  @keyframes building-pulse {
    50% {
      opacity: 0.4;
    }
  }
</style>
