---
// A Mac app's screenshot on a Mac screen built in HTML and CSS: the app is the only picture, cropped with no
// background, and the wallpaper, menu bar, notch and Dock are drawn around it. `desktop` picks the scene:
//   window   the app's window in the middle of the screen, on a MacBook, with the app in the menu bar and the Dock
//   menubar  the top of the screen, with the popover hanging under the app's menu bar icon on the right
//   notch    the top of the screen, with the panel growing out of the notch
// The screenshot is a retina capture, shown at half its pixel size. The scene is laid out in Mac points (1em is
// one point, see .mac-scene) and scales with the frame, so a small popover gets a small scene, shown big.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { fmtDay, logoFor, type Review } from '../lib/reviews';

interface Props {
  review: Review;
  screen: ImageMetadata;
}

const { review, screen } = Astro.props;
const { app, brand, date, desktop, shadow, screenshotAlt } = review.data;
const logo = logoFor(review);

// the screenshot in points (a 2× capture)
const w = Math.round(screen.width / 2);
const h = Math.round(screen.height / 2);

// the parts of the screen, in points, roughly a 14-inch MacBook Pro's
const BAR = 32; // the menu bar (as tall as the notch)
const NOTCH = 190; // the notch's width
const DOCK = 76; // the Dock, with its gap above the bottom edge
const ICON = 297; // the app's menu bar icon's centre, from the right edge: past the clock and four status icons
const PAD = 48; // room around a popover or panel

// the scene's size, and where the app goes
let width: number;
let height: number;
let left: number;
let top: number;
if (desktop === 'menubar') {
  // the popover under its icon, kept on screen
  width = Math.max(w + 2 * PAD, ICON + w / 2 + PAD, 720);
  height = BAR + 6 + h + PAD + 8;
  left = Math.min(Math.max(width - ICON - w / 2, PAD), width - PAD - w);
  top = BAR + 6;
} else if (desktop === 'notch') {
  // the panel hangs from the top edge, centred on the notch
  width = Math.max(w + 2 * 150, NOTCH + 2 * 150, 620); // room for Finder on the left and the time on the right
  height = Math.max(h, BAR) + PAD + 8;
  left = (width - w) / 2;
  top = 0;
} else {
  // a 16:10 screen with the window in the middle, between the menu bar and the Dock
  width = Math.max(w * 1.24, (h + BAR + DOCK + 80) * 1.6);
  height = width / 1.6;
  left = (width - w) / 2;
  top = BAR + (height - BAR - DOCK - h) / 2;
}
const isCrop = desktop !== 'window';
// the clock shows the review's day: "Tue Nov 3  9:41 AM"
const weekday = new Date(`${date}T12:00:00`).toLocaleDateString('en-US', { weekday: 'short' });
const clock = `${weekday} ${fmtDay(date).replace(/, \d{4}$/, '')}`;
// the menu bar shows what's in that part of the screen: for a window, its app's menus and all the status icons;
// for a menu bar app, only the right side; for a notch app, a narrow middle: Finder and the time either side
const menus = desktop === 'window' ? [app, 'File', 'Edit', 'View', 'Window', 'Help'] : ['Finder'];
const isNotch = desktop === 'notch';
// a length in points, for the inline styles
const pt = (value: number) => `${Math.round(value * 10) / 10}em`;
---

<span
  class:list={['mac', `mac-is-${desktop}`, { 'mac-crop': isCrop }]}
  style={`--fade:${Math.round(((height - PAD * 0.6) / height) * 1000) / 10}%`}
>
  <span class="mac-lid">
    <span
      class="mac-screen"
      style={`aspect-ratio:${Math.round(width)} / ${Math.round(height)};--brand:${brand}`}
    >
      <span class="mac-scene" style={`--width:${Math.round(width)}`}>
        <span class="mac-bar" aria-hidden="true">
          {desktop !== 'menubar' && (
            <span class="mac-menus">
              <svg class="mac-apple" viewBox="0 0 24 24">
                <path d="M12.15 6.9c-.95 0-2.42-1.08-3.96-1.04-2.04.03-3.91 1.18-4.96 3.01-2.12 3.68-.55 9.1 1.52 12.09 1.01 1.45 2.2 3.09 3.79 3.04 1.52-.07 2.09-.99 3.94-.99 1.83 0 2.35.99 3.96.95 1.64-.03 2.68-1.48 3.68-2.95 1.16-1.69 1.64-3.33 1.66-3.42-.04-.01-3.18-1.22-3.22-4.86-.03-3.04 2.48-4.49 2.6-4.56-1.43-2.09-3.62-2.32-4.39-2.38-2-.16-3.68 1.09-4.61 1.09zm3.38-3.07c.84-1.01 1.4-2.43 1.25-3.83-1.21.05-2.66.81-3.53 1.82-.78.9-1.46 2.34-1.27 3.71 1.34.1 2.71-.69 3.56-1.7"></path>
              </svg>
              {menus.map((menu, index) => (
                <span class:list={['mac-menu', { 'mac-menu-app': index === 0 }]}>{menu}</span>
              ))}
            </span>
          )}
          <span class="mac-status">
            {desktop === 'menubar' && (
              // the app's icon, pressed: logo.png, or its first letter on its brand colour
              <span class="mac-status-app">
                {logo ? (
                  <Image src={logo} alt="" widths={[48]} sizes="16px" />
                ) : (
                  <span class="mac-letter">{app.slice(0, 1)}</span>
                )}
              </span>
            )}
            <svg viewBox="0 0 24 24" class="mac-icon">
              <rect x="2" y="7" width="18" height="10" rx="3"></rect>
              <rect x="4.5" y="9.5" width="10" height="5" rx="1" class="mac-fill"></rect>
              <path d="M22 11v2"></path>
            </svg>
            <svg viewBox="0 0 24 24" class="mac-icon">
              <path d="M2 9a15 15 0 0 1 20 0M5 13a10 10 0 0 1 14 0M8.5 16.5a5 5 0 0 1 7 0"></path>
              <circle cx="12" cy="20" r="1" class="mac-fill"></circle>
            </svg>
            {!isNotch && (
              <svg viewBox="0 0 24 24" class="mac-icon">
                <circle cx="10" cy="10" r="6"></circle>
                <path d="m15 15 6 6"></path>
              </svg>
            )}
            {!isNotch && (
              <svg viewBox="0 0 24 24" class="mac-icon">
                <rect x="3" y="5" width="18" height="5" rx="2.5"></rect>
                <rect x="3" y="14" width="18" height="5" rx="2.5"></rect>
              </svg>
            )}
            <span class:list={['mac-clock', { 'mac-clock-short': isNotch }]}>
              {!isNotch && <>{clock}&nbsp;&nbsp;</>}9:41 AM
            </span>
          </span>
        </span>
        {desktop !== 'menubar' && <span class="mac-notch" aria-hidden="true"></span>}
        <Image
          class:list={['mac-app', { 'mac-shadow': shadow }]}
          src={screen}
          alt={screenshotAlt ?? ''}
          widths={[...new Set([Math.min(800, screen.width), screen.width])]}
          sizes={`(max-width: 860px) ${Math.round((w / width) * 100)}vw, ${Math.round((w / width) * 800)}px`}
          style={`left:${pt(left)};top:${pt(top)};width:${pt(w)}`}
        />
        {desktop === 'window' && (
          <span class="mac-dock" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <span class="mac-dock-app">
              {logo ? (
                <Image src={logo} alt="" widths={[96, 192]} sizes="48px" />
              ) : (
                <span class="mac-letter">{app.slice(0, 1)}</span>
              )}
            </span>
            <i></i>
            <i></i>
            <i></i>
          </span>
        )}
      </span>
    </span>
  </span>
  {!isCrop && <span class="mac-base" aria-hidden="true"></span>}
</span>
