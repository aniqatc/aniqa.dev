---
// The end of a launch case study: a Get it row like a store listing (icon, name, price, requirements, Get it and
// Gift it), then, with launch.signup, an email sign-up for what's next that adds people to the launch's own
// Loops list (UpdatesSignup with `launch`, posting to /api/launch-signup). Everything shown comes from the
// entry's frontmatter; see content.config.ts and templates/project/index.md.
import { Image } from 'astro:assets';
import GetItButton from './GetItButton.astro';
import UpdatesSignup from './UpdatesSignup.astro';
import { getItHref } from '../lib/launch';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, price, priceNote, requires } = project.data;
const launch = project.data.launch!;
const getHref = getItHref(project);
// the line under the name: "$2.99 · Launch price · macOS 13 or later"
const details = [price, priceNote, requires].filter(Boolean).join(' · ');
---

<section class="launch-end" aria-label={`Get ${title}`} style={`--brand:${launch.brand}`}>
  {/* ---------- Get it: the app and its price on the left, the buttons on the right ---------- */}
  <div class="launch-end-get">
    <div class="launch-app">
      <Image class="launch-app-icon" src={launch.logo} alt="" widths={[112, 224]} sizes="56px" />
      <div class="launch-app-text">
        <p class="launch-app-name">{title}</p>
        {details && <p class="launch-app-details">{details}</p>}
      </div>
    </div>
    <p class="launch-buttons">
      {getHref && <GetItButton href={getHref} label="Get it" />}
      {launch.giftUrl && <GetItButton href={launch.giftUrl} label="Gift it" variant="outline" />}
    </p>
  </div>

  {/* ---------- what's next: the launch's own email list ---------- */}
  {
    launch.signup && (
      <div class="launch-end-signup">
        <p class="label">{launch.signup.title}</p>
        <p class="launch-end-text">{launch.signup.text}</p>
        <div class="launch-end-form">
          <UpdatesSignup launch={project.id} placeholder={launch.signup.placeholder} thanks={launch.signup.thanks} />
        </div>
      </div>
    )
  }
</section>

<style>
  /* ---------- the card: its own box at the end of the page, lit faintly by the app's colour ---------- */
  .launch-end {
    display: flex;
    flex-direction: column;
    margin-top: 12px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--brand) 14%, transparent), transparent 55%),
      var(--surface);
    overflow: hidden;
  }
  .launch-end p {
    margin: 0;
  }
  .launch-end-get,
  .launch-end-signup {
    padding: 24px 28px;
  }

  /* ---------- Get it: app on the left, buttons on the right (stacked on phones) ---------- */
  .launch-end-get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 24px;
  }
  .launch-app {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }
  .launch-app-icon {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 13px;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.35);
  }
  .launch-app-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .launch-app-name {
    font: 700 19px/1.15 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .launch-app-details {
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--muted);
  }
  .launch-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* ---------- the sign-up, under a hairline ---------- */
  .launch-end-signup {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 35%, transparent);
  }
  .launch-end-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--body);
  }
  .launch-end-form {
    max-width: 460px;
    margin-top: 6px;
  }
  @media (max-width: 560px) {
    .launch-end-get,
    .launch-end-signup {
      padding: 20px;
    }
    .launch-buttons {
      width: 100%;
    }
  }
</style>
