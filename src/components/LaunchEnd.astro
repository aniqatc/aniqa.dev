---
// The end of a launch case study, a centred card like an App Store listing: icon, name, price and requirements,
// Get it and Gift it, then, with launch.signup, an email sign-up for what's next that adds people to the launch's own
// Loops list (UpdatesSignup with `launch`, posting to /api/launch-signup). Everything shown comes from the
// entry's frontmatter; see content.config.ts and templates/project/index.md.
import { Image } from 'astro:assets';
import GetItButton from './GetItButton.astro';
import UpdatesSignup from './UpdatesSignup.astro';
import { getItHref } from '../lib/launch';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, price, priceNote, requires } = project.data;
const launch = project.data.launch!;
const getHref = getItHref(project);
// the line under the name: "$2.99 · Launch price · macOS 13 or later"
const details = [price, priceNote, requires].filter(Boolean).join(' · ');
---

<section class="launch-end" aria-label={`Get ${title}`} style={`--brand:${launch.brand}`}>
  {/* ---------- Get it: icon, name, price line and the buttons, on one centre line ---------- */}
  <div class="launch-end-get">
    <Image class="launch-app-icon" src={launch.logo} alt="" widths={[128, 256]} sizes="64px" />
    <p class="launch-app-name">{title}</p>
    {details && <p class="launch-app-details">{details}</p>}
    <p class="launch-buttons">
      {getHref && <GetItButton href={getHref} label="Get it" />}
      {launch.giftUrl && <GetItButton href={launch.giftUrl} label="Gift it" variant="outline" />}
    </p>
  </div>

  {/* ---------- what's next: the launch's own email list, under a hairline ---------- */}
  {
    launch.signup && (
      <div class="launch-end-signup">
        <p class="label">{launch.signup.title}</p>
        <p class="launch-end-text">{launch.signup.text}</p>
        <div class="launch-end-form">
          <UpdatesSignup launch={project.id} placeholder={launch.signup.placeholder} thanks={launch.signup.thanks} />
        </div>
      </div>
    )
  }
</section>

<style>
  /* ---------- the card: its own box at the end of the page, lit faintly by the app's colour, all centred ---------- */
  .launch-end {
    display: flex;
    flex-direction: column;
    margin-top: 12px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--brand) 14%, transparent), transparent 55%),
      var(--surface);
    overflow: hidden;
    text-align: center;
  }
  .launch-end p {
    margin: 0;
  }

  /* ---------- Get it ---------- */
  .launch-end-get {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 32px 28px 28px;
  }
  .launch-app-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 4px;
    border-radius: 15px;
    box-shadow: 0 8px 22px rgb(0 0 0 / 0.4);
  }
  .launch-app-name {
    font: 700 22px/1.15 var(--font-display);
    letter-spacing: -0.015em;
    color: var(--fg);
  }
  .launch-app-details {
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--muted);
  }
  .launch-end .launch-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
  }

  /* ---------- the sign-up ---------- */
  .launch-end-signup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 24px 28px 28px;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 35%, transparent);
  }
  .launch-end-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--body);
  }
  .launch-end-form {
    width: 100%;
    max-width: 400px;
    margin-top: 6px;
  }
  /* the form's thanks line, centred like the rest */
  .launch-end-form :global(.updates-signup-thanks) {
    justify-content: center;
  }
  @media (max-width: 560px) {
    .launch-end-get,
    .launch-end-signup {
      padding-inline: 20px;
    }
  }
</style>
