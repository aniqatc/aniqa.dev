---
// Home page: one featured project in the work column, in place of App reviews and Selected work.
// Edit or switch it off in src/lib/spotlight.ts.
import type { SPOTLIGHT } from '../lib/spotlight';

interface Props {
  spotlight: NonNullable<typeof SPOTLIGHT>;
}
const { spotlight } = Astro.props;
---

<div class="spotlight">
  {/* ---------- Header: the same row as Selected work's ---------- */}
  <div class="work-head">
    <h2 class="label" id="pf-work">{spotlight.label}</h2>
    <a href={spotlight.headerLink.href}>{spotlight.headerLink.text}</a>
  </div>

  {/* ---------- The picture ---------- */}
  <div class="spotlight-image">
    <img src={spotlight.image} alt={spotlight.imageAlt} width="1200" height="630" loading="eager" decoding="async" />
  </div>

  {/* ---------- Title, status and blurb ---------- */}
  <h3 class="spotlight-title">
    {spotlight.title}
    <span class="spotlight-status"><i aria-hidden="true"></i>{spotlight.status}</span>
  </h3>
  <p class="spotlight-blurb">{spotlight.blurb}</p>

  {/* ---------- Buttons: filled for the product, outlined for the story ---------- */}
  <div class="spotlight-actions">
    <a class="spotlight-button spotlight-button-filled" href={spotlight.primary.href} target="_blank" rel="noopener">
      {spotlight.primary.text} <span aria-hidden="true">↗</span>
    </a>
    <a class="spotlight-button" href={spotlight.secondary.href}>
      {spotlight.secondary.text} <span aria-hidden="true">→</span>
    </a>
  </div>
  {spotlight.note && <p class="spotlight-note label">{spotlight.note}</p>}
</div>

<style>
  /* ---------- Picture: rounded, with the site's hairline ---------- */
  .spotlight-image {
    display: block;
    margin-top: 22px;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }
  .spotlight-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
  }

  /* ---------- Title with its status ---------- */
  .spotlight-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 26px 0 0;
    font: 500 26px/1.15 var(--font-body);
    color: var(--fg);
  }
  .spotlight-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  /* the same pulsing dot as Building */
  .spotlight-status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
    animation: spotlight-pulse 2s ease-in-out infinite;
  }
  @keyframes spotlight-pulse {
    50% {
      opacity: 0.4;
    }
  }
  .spotlight-blurb {
    margin: 14px 0 0;
    max-width: 58ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- Buttons: pills like the Updates button ---------- */
  .spotlight-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .spotlight-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 38px;
    padding: 0 17px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--fg);
    font: 500 10.5px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .spotlight-button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .spotlight-button-filled {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }
  .spotlight-button-filled:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }
  .spotlight-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .spotlight-note {
    margin: 22px 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .spotlight-status i {
      animation: none;
    }
  }
</style>
