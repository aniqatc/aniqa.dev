---
// An email sign-up: new things on the portfolio intro, new reviews on /reviews, and a launch's own list at the
// end of its case study (with `launch`, through Loops).
// It subscribes the address to Buttondown (the username in contact.ts), tagged so you can tell the lists apart,
// then says thanks. How it sends is in src/scripts/signup.ts.
import { SIGNUP_ACTION } from '../lib/contact';

interface Props {
  /** the field's placeholder, also its label for screen readers */
  placeholder?: string;
  /** what the form says once an address is in */
  thanks?: string;
  /** the Buttondown tag for these subscribers, e.g. "reviews" */
  tag?: string;
  /** 'stub': an outlined button, for the sign-up joined under a review's Try it card */
  variant?: 'default' | 'stub';
  /** a launch case study's slug: signs up to that launch's Loops list (src/pages/api/launch-signup.ts), not Buttondown */
  launch?: string;
}

const {
  placeholder = 'Your email, for new things',
  // Confirmation happens through Buttondown's welcome automation, if configured.
  thanks = 'Thanks! You’ll hear about new things from me soon',
  tag = 'updates',
  variant = 'default',
  launch,
} = Astro.props;
// where the address goes: a launch's Loops list, or Buttondown with the tag
const endpoint = launch ? '/api/launch-signup' : '/api/subscribe';
---

<form
  class:list={['updates-signup', { 'updates-signup-stub': variant === 'stub' }]}
  aria-label="Get updates"
  action={launch ? endpoint : SIGNUP_ACTION}
  method="post"
  data-signup
  data-signup-endpoint={endpoint}
  data-thanks={thanks}
  novalidate
>
  <input type="hidden" name="embed" value="1" />
  {launch ? <input type="hidden" name="launch" value={launch} /> : <input type="hidden" name="tag" value={tag} />}
  <span class="updates-signup-fields" data-signup-fields>
    <input
      class="updates-signup-email"
      data-signup-email
      type="email"
      name="email"
      placeholder={placeholder}
      autocomplete="email"
      aria-label={placeholder}
      required
    />
    <button class="updates-signup-button" type="submit" data-signup-button>
      Notify me
    </button>
  </span>
  <span class="updates-signup-thanks" role="status" data-signup-thanks hidden></span>
</form>

<script>
  import '../scripts/signup';
</script>

<style>
  .updates-signup-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .updates-signup-fields[hidden] {
    display: none;
  }
  .updates-signup-email {
    flex: 1 1 180px;
    min-width: 0;
    height: 34px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    font: 400 12.5px var(--font-body);
  }
  .updates-signup-email::placeholder {
    color: var(--muted);
  }
  .updates-signup-button {
    height: 34px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  /* while the address is on its way */
  .updates-signup-button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .updates-signup-button:hover {
    background: var(--accent);
  }
  /* the stub: one row, and an outlined button so the app's Try button stays the only filled one */
  .updates-signup-stub .updates-signup-fields {
    flex-wrap: nowrap;
  }
  .updates-signup-stub .updates-signup-button {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--fg);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .updates-signup-stub .updates-signup-button:hover {
    border-color: var(--accent);
    background: transparent;
    color: var(--accent);
  }
  .updates-signup-email:focus-visible,
  .updates-signup-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* the same height as the field, so nothing moves when it swaps in */
  .updates-signup-thanks {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    font-size: 12.5px;
    color: var(--muted);
  }
  /* the stub keeps the default thanks styling, on one line */
  .updates-signup-stub .updates-signup-thanks {
    white-space: nowrap;
  }
  .updates-signup-thanks[hidden] {
    display: none;
  }
</style>
