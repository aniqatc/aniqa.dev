---
// The top of a launch case study, in place of the website screenshot: a big picture with a row of thumbnails
// under it, four to a row (two on phones). It starts on the app on a Mac screen (MacScreen.astro, as on Mac app
// reviews); tapping a thumbnail shows that picture in the big spot instead, with its caption, and the first
// thumbnail brings the Mac screen back. A gallery item with a `video` plays it there instead, muted and looping
// like a GIF. The data is the entry's `launch` block.
//
// All the big pictures sit in the same grid cell, so the spot keeps the height of the tallest and nothing below
// jumps when you switch. Only the chosen one is visible (data-shown).
import { getImage, Image } from 'astro:assets';
import MacScreen from './MacScreen.astro';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const launch = project.data.launch!;

// ---------- the Mac screen: the scene for MacScreen, dated the release month ----------
const scene = {
  app: project.data.title,
  brand: launch.brand,
  date: `${project.data.released}-01`,
  desktop: launch.desktop,
  shadow: launch.shadow,
  alt: launch.screenAlt,
  logo: launch.logo,
};
// the caption while the Mac screen shows: the entry's, or where the app lives
const DEFAULT_SCREEN_CAPTIONS = { menubar: 'In the menu bar', window: 'On the desktop', notch: 'In the notch' };
const screenCaption = launch.screenCaption ?? DEFAULT_SCREEN_CAPTIONS[launch.desktop];

// ---------- the gallery: a clip's poster is its still, at the big spot's size ----------
const gallery = await Promise.all(
  launch.gallery.map(async (shot) => ({
    ...shot,
    poster: shot.video ? (await getImage({ src: shot.src, width: 1280, format: 'webp' })).src : undefined,
  })),
);
---

<figure class="launch-hero" data-launch-hero>
  {/* ---------- the big spot: the Mac screen, then each gallery picture, one shown at a time ---------- */}
  <div class="launch-stage">
    <div class="launch-slide" data-launch-slide="0" data-shown="true">
      <MacScreen scene={scene} screen={launch.screen} />
    </div>
    {
      gallery.map((shot, index) => (
        <div class="launch-slide" data-launch-slide={index + 1} data-shown="false" aria-hidden="true">
          {shot.video ? (
            // a clip: muted and looping like a GIF; it only loads and plays once its thumbnail is tapped
            <video
              class="launch-slide-image"
              src={shot.video}
              poster={shot.poster}
              width={shot.src.width}
              height={shot.src.height}
              aria-label={shot.alt}
              muted
              loop
              playsinline
              preload="none"
            />
          ) : (
            <Image
              class="launch-slide-image"
              src={shot.src}
              alt={shot.alt}
              widths={[640, 960, 1280]}
              sizes="(max-width: 640px) 100vw, 600px"
              loading="lazy"
            />
          )}
        </div>
      ))
    }
  </div>
  <figcaption class="launch-caption" aria-live="polite" data-launch-caption>{screenCaption}</figcaption>

  {/* ---------- thumbnails: the Mac screen first, then the gallery ---------- */}
  {
    launch.gallery.length > 0 && (
      <ul class="launch-thumbs" aria-label="Pictures">
        <li>
          <button
            class="launch-thumb launch-thumb-screen"
            type="button"
            aria-pressed="true"
            data-launch-thumb="0"
            data-caption={screenCaption}
          >
            <Image src={launch.screen} alt={launch.screenAlt} widths={[240, 480]} sizes="160px" />
          </button>
        </li>
        {gallery.map((shot, index) => (
          <li>
            <button
              class:list={['launch-thumb', { 'launch-thumb-clip': shot.video }]}
              type="button"
              aria-pressed="false"
              data-launch-thumb={index + 1}
              data-caption={shot.caption}
            >
              <Image src={shot.src} alt={shot.alt} widths={[240, 480]} sizes="(max-width: 640px) 45vw, 160px" />
              {shot.video && <span class="launch-thumb-play" aria-hidden="true" />}
            </button>
          </li>
        ))}
      </ul>
    )
  }
</figure>

<script>
  import { onPage } from '../scripts/page';

  // ---------- tapping a thumbnail shows its picture in the big spot ----------
  onPage(() => {
    const hero = document.querySelector<HTMLElement>('[data-launch-hero]');
    if (!hero) return;
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-launch-slide]')];
    const thumbs = [...hero.querySelectorAll<HTMLButtonElement>('[data-launch-thumb]')];
    const caption = hero.querySelector<HTMLElement>('[data-launch-caption]');
    const stayStill = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (chosen: HTMLButtonElement) => {
      const index = chosen.dataset.launchThumb;
      for (const slide of slides) {
        const shown = slide.dataset.launchSlide === index;
        slide.dataset.shown = String(shown);
        if (shown) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
        // a clip plays while it's shown (or, with reduced motion, waits on its poster with controls)
        const clip = slide.querySelector('video');
        if (!clip) continue;
        if (shown && stayStill) clip.controls = true;
        else if (shown) clip.play().catch(() => {});
        else clip.pause();
      }
      for (const thumb of thumbs) thumb.setAttribute('aria-pressed', String(thumb === chosen));
      if (caption) caption.textContent = chosen.dataset.caption ?? '';
    };
    const onClick = (event: Event) => show(event.currentTarget as HTMLButtonElement);
    for (const thumb of thumbs) thumb.addEventListener('click', onClick);
    return () => {
      for (const thumb of thumbs) thumb.removeEventListener('click', onClick);
      for (const clip of hero.querySelectorAll('video')) clip.pause();
    };
  });
</script>

<style>
  /* ---------- the big spot: every picture in one cell, so the height never changes ---------- */
  .launch-hero {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
  }
  .launch-stage {
    display: grid;
  }
  .launch-slide {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    min-width: 0;
  }
  /* the others still hold their space (the grid cell), they just aren't seen; not [hidden], which removes them */
  .launch-slide[data-shown='false'] {
    visibility: hidden;
  }
  .launch-slide > :global(*) {
    width: 100%;
  }
  .launch-slide-image {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .launch-caption {
    font: 400 11px/1.4 var(--font-mono);
    color: var(--muted);
  }

  /* ---------- thumbnails, the chosen one outlined ---------- */
  .launch-thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .launch-thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
    cursor: pointer;
    opacity: 0.7;
    transition:
      border-color 0.2s,
      opacity 0.2s;
  }
  .launch-thumb:hover,
  .launch-thumb[aria-pressed='true'] {
    opacity: 1;
  }
  .launch-thumb[aria-pressed='true'] {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .launch-thumb:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .launch-thumb img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  /* a clip's thumbnail: a small play mark in the corner */
  .launch-thumb-clip {
    position: relative;
  }
  .launch-thumb-play {
    position: absolute;
    right: 6px;
    bottom: 6px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
  }
  .launch-thumb-play::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 8px;
    border-style: solid;
    border-width: 4px 0 4px 6px;
    border-color: transparent transparent transparent #fff;
  }
  /* the calendar is tall: show its top, where the doors start */
  .launch-thumb-screen img {
    object-position: top;
  }
  @media (prefers-reduced-motion: reduce) {
    .launch-thumb {
      transition: none;
    }
  }
</style>
