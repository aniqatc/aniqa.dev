---
// One floating card for the lab archive: the hovered row's screenshot and caption.
// Each row carries a small WebP of its screenshot in data-preview; hover-preview.ts only loads them once
// someone first hovers the archive, so the page stays light.
// An entry that isn't a website (no live site, with a sketch.astro) shows its sketch itself instead, running,
// shrunk to fit. It stays hidden, so it doesn't animate, until its row is hovered, and inert, so its controls
// can't be reached. Its screenshots and sketches are stacked layers, so moving to another row crossfades between
// them (follow-card.css).
import '../styles/follow-card.css';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import '../styles/demo.css';
import type { LabEntry } from '../lib/projects';

interface Props {
  entries: LabEntry[];
}

const { entries } = Astro.props;
const sketches = import.meta.glob<{ default: AstroComponentFactory }>(
  '../content/experiments/*/sketch.astro',
  {
    eager: true,
  },
);
const liveSketches = entries
  .filter((entry) => !entry.data.live)
  .map((entry) => ({
    slug: entry.id,
    Sketch: sketches[`../content/experiments/${entry.id}/sketch.astro`]?.default,
  }))
  .filter(({ Sketch }) => Sketch);
---

<div class="tip follow-card" aria-hidden="true">
  <div class="tip-media">
    <img class="tip-image follow-layer" alt="" width="232" height="145" decoding="async" hidden />
    <img class="tip-image follow-layer" alt="" width="232" height="145" decoding="async" hidden />
    {liveSketches.map(({ slug, Sketch }) => (
      <div class="tip-sketch follow-layer" data-sketch-slug={slug} hidden inert>
        {/* .stage: sketches look for their stage (to hear Pause); unstyled here, since detail.css is only on entry pages */}
        <div class="tip-sketch-stage stage">
          <Sketch />
        </div>
      </div>
    ))}
  </div>
  <div class="tip-cap">
    <b></b>
    <span></span>
  </div>
</div>

<script>
  import '../scripts/hover-preview';
</script>
